# Copy this file to .env and fill in what you have.
# Every integration below is optional — the app runs fully in "demo mode"
# with sane fallbacks when a key is missing (see README for details).

# --- Database ---------------------------------------------------------
# Postgres is required (the app targets serverless hosting, e.g. Vercel,
# where a SQLite file wouldn't persist between requests). Any Postgres works:
# Neon, Supabase, Prisma Postgres, Vercel Postgres, RDS, or a local instance.
DATABASE_URL="postgresql://user:password@localhost:5432/stilldreaming"

# Optional. Only needed if DATABASE_URL is a pooled connection (e.g. Supabase's
# "Transaction pooler" string, port 6543, or any PgBouncer-fronted URL).
# `prisma migrate deploy` needs a direct, unpooled connection — set this to
# Supabase's "Direct connection" string (port 5432) if you hit migration
# errors. Leave unset for a plain, unpooled Postgres and DATABASE_URL is used
# for both.
# DIRECT_URL="postgresql://user:password@host:5432/stilldreaming"

# --- AI chatbot (Anthropic / Claude) -----------------------------------
# Without this, the chatbot runs in demo mode: canned, clearly-labeled
# responses that still demonstrate the lead-capture flow.
ANTHROPIC_API_KEY=""

# --- Outbound email notifications (Resend) -----------------------------
# Without this, "sending" a notification just logs it and records an
# EMAIL_QUEUED activity on the lead instead of an EMAIL_SENT one.
RESEND_API_KEY=""
LEAD_NOTIFICATION_EMAIL="info@trygodu.com"

# --- Admin dashboard -----------------------------------------------------
# No password to set here — the first visit to /admin lets you create the
# owner account (email + password, stored hashed in the database). That
# form disables itself the moment one account exists.
# ADMIN_SESSION_SECRET signs the login session cookie — set this to a real
# random value in production (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET="dev-only-secret-change-me"
