# Copy this file to .env and fill in what you have.
# Every integration below is optional — the app runs fully in "demo mode"
# with sane fallbacks when a key is missing (see README for details).

# --- Database ---------------------------------------------------------
# SQLite works out of the box for local dev / small deployments.
# For production, point this at Postgres (Prisma Postgres, Supabase, Neon, etc.)
# and change the `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# --- AI chatbot (Anthropic / Claude) -----------------------------------
# Without this, the chatbot runs in demo mode: canned, clearly-labeled
# responses that still demonstrate the lead-capture flow.
ANTHROPIC_API_KEY=""

# --- Outbound email notifications (Resend) -----------------------------
# Without this, "sending" a notification just logs it and records an
# EMAIL_QUEUED activity on the lead instead of an EMAIL_SENT one.
RESEND_API_KEY=""
LEAD_NOTIFICATION_EMAIL="info@trygodu.com"

# --- Admin dashboard -----------------------------------------------------
# Password for /admin. Change this before deploying anywhere public.
ADMIN_PASSWORD="changeme"
ADMIN_SESSION_SECRET="dev-only-secret-change-me"
